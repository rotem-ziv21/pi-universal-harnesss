# --- Secrets: never, under any circumstances ---
secrets.json
*.key
.env
.env.*
!.env.example

# --- Local harness state (machine-local, never shared) ---
# Anchored with a leading slash so these match ONLY at the repository root.
# An unanchored `state/` also matches `src/state/`, which silently excluded the
# entire canonical-state module from the repo: it worked locally, where the files
# exist, and every fresh clone failed to load the extension.
/state/
/.harness-state/
/*.jsonl

# --- Node ---
node_modules/
npm-debug.log*
*.tsbuildinfo

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Build output (there is none; jiti runs TS directly) ---
dist/
build/

# The original mission brief — kept locally, not published.
promt.md

# Personal Hebrew explainer — kept locally, not published.
docs/הסבר-בעברית.md
