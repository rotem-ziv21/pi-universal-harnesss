{
  "name": "pi-universal-harness",
  "version": "0.1.0",
  "description": "A portable, model-agnostic, task-agnostic execution harness for the Pi coding agent. The model reasons; the harness governs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "agent",
    "harness",
    "guardrails",
    "typesafe",
    "jev",
    "openrouter"
  ],
  "devDependencies": {
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
